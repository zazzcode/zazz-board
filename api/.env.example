# Zazz Board — API Environment Variables
# Copy this file to api/.env and keep the password aligned with your root .env

# Main database — must match the POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgres://postgres:password@localhost:5433/zazz_board_db

# Test database (used only by automated tests — cleared on each run)
DATABASE_URL_TEST=postgres://postgres:password@localhost:5433/zazz_board_test

# Neon (optional) — API key (PAT) for Neon CLI / management tooling only.
# The app connects to the database via DATABASE_URL; this is not the DB credential.
# NEON_API_KEY=
#
# --- Neon runtime (uncomment and fill to run on Neon; see .zazz/docs/neon-setup.md) ---
# All values below are generated by: npx --yes neon@latest env pull --project-id <project-id>
# STORAGE_BACKEND=neon
# NEON_STORAGE_BUCKET=zazz-board-attachments
# DATABASE_URL=postgresql://<user>:<password>@<endpoint-id>-pooler.<cluster>.<region>.aws.neon.tech/zazz_board_db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint-id>.<cluster>.<region>.aws.neon.tech/zazz_board_db?sslmode=require
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<cluster>.<region>.aws.neon.tech
# AWS_REGION=us-east-2

# Application
NODE_ENV=development
PORT=3030
LOG_LEVEL=info
